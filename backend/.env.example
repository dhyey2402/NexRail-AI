# NexRail AI Backend Configuration Template (Production & Development)
# Copy this file to .env and fill in the values for your environment.

# ── API & Server Settings ───────────────────────────────────────
API_TITLE="NexRail AI"
API_VERSION="1.0"
HOST="0.0.0.0"
PORT=8000

# ── Authentication & Security (REQUIRED IN PRODUCTION) ─────────
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS Configuration ──────────────────────────────────────────
# Comma-separated allowed origins (no spaces around URLs)
# Production example: https://nexrail-admin-six.vercel.app,https://nexrail-passenger.vercel.app
CORS_ORIGINS="https://nexrail-admin-six.vercel.app,https://nexrail-passenger.vercel.app,http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# ── Database Configuration ──────────────────────────────────────
# Local development: sqlite:///./train_eta.db
# Production (PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./train_eta.db"

# ── External APIs (Required for live train tracking & weather) ─
OPENWEATHER_API_KEY=""
RAILRADAR_API_KEY=""

OPENWEATHER_BASE_URL="https://api.openweathermap.org"
RAILRADAR_BASE_URL="https://api.railradar.in"

# ── API Client Settings ─────────────────────────────────────────
HTTP_TIMEOUT=10
